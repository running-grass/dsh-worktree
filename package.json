{
  "name": "dsh-worktree",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: run sessions in git worktrees, with the branch named from the generated session title",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "git",
    "worktree",
    "branch",
    "workspace"
  ],
  "type": "module",
  "main": "./index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "service.js",
    "git.js",
    "branch.js",
    "state.js",
    "typert.host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-workspace": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/dsh-home-paths": { "optional": true },
    "@deepseek-ai/dsh-workspace": { "optional": true },
    "@deepseek-ai/dsh-session-projection": { "optional": true }
  }
}